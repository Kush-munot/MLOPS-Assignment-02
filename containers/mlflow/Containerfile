FROM docker.io/library/python:3.12-slim

RUN pip install --no-cache-dir --default-timeout=120 --retries 10 mlflow==3.17.2

RUN mkdir -p /mlflow/artifacts
WORKDIR /mlflow
EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--serve-artifacts"]
